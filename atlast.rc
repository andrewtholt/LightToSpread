^set SAVE_ALLOWED true
^set EXIT_COMMAND true
^set ON_CHANGE 
^lock ON_CHANGE
^set INTERACTIVE false
^set GROUP testing
^set CLEARDB true
^set SHOW_SENDER false
^set AUTOCONNECT true
^set ON_CONNECT CONNECTED
^set REMOTE_CREATE false
^lock REMOTE_CREATE
