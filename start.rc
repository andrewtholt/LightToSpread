^set SET_FMT %s
^set STALE_AFTER 600
^set SERVER 4803@192.168.10.124
^lock SERVER
^set IGN_GLOBAL false
^set OWN_MESSAGES false
^set ADD_CR false
^set CLIENT raw
^set ALTSERVER 4803@127.0.0.1
^set PROMPT toSpread>
