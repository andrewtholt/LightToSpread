^set DEBUG true
^set COMMS_VARS false
^set PASSTHROUGH false
^set SAVE_ALLOWED true
^set EXIT_COMMAND true
^set ON_CHANGE 
^lock ON_CHANGE
^set INTERACTIVE true
^set GROUP global
^set CLEARDB true
^set SHOW_SENDER false
^set AUTOCONNECT false
^set ON_CONNECT 
^set REMOTE_CREATE false
^lock REMOTE_CREATE
